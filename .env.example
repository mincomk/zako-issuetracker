# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Admin User IDs (comma-separated Discord user IDs)
ADMIN_IDS=123456789012345678,987654321098765432

# Database Configuration
SQLITE_FILE=./data/issues.db

# GitHub Integration (optional)
# Set GITHUB_REPO to enable fetching issues/PRs from a GitHub repo
# GITHUB_TOKEN is optional; omit for public repos (rate limit: 60 req/hr)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=ghp_your_personal_access_token
